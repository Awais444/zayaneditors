# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://example.com

# Video provider: "bunny" | "vimeo" | "mp4"
NEXT_PUBLIC_VIDEO_PROVIDER=mp4
# Bunny Stream library id (only when VIDEO_PROVIDER=bunny)
NEXT_PUBLIC_BUNNY_LIBRARY_ID=

# Email (Resend) — https://resend.com
RESEND_API_KEY=
LEAD_TO_EMAIL=you@example.com
LEAD_FROM_EMAIL="Studio <leads@yourdomain.com>"

# Analytics & chat (load only after cookie consent)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=default

# Google Search Console verification token
NEXT_PUBLIC_GSC_VERIFICATION=
